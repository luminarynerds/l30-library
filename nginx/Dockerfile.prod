# Production Nginx Dockerfile for L30 Library
FROM nginx:alpine

# Install utilities for health checks and security
RUN apk add --no-cache curl ca-certificates libcap netcat-openbsd

# Create non-root user (nginx user already exists in the image)
RUN addgroup -g 101 -S nginx && \
    adduser -S -D -H -u 101 -h /var/cache/nginx -s /sbin/nologin -G nginx -g nginx nginx || true

# Copy production nginx configuration
COPY ./nginx/nginx.prod.conf /etc/nginx/nginx.conf

# Copy WAF configuration files
COPY ./nginx/waf-rules.conf /etc/nginx/waf-rules.conf
COPY ./nginx/waf-module-loader.conf /etc/nginx/waf-module-loader.conf

# Copy startup script
COPY ./nginx/run-nginx.sh /usr/local/bin/run-nginx.sh
RUN chmod +x /usr/local/bin/run-nginx.sh

COPY ./public/404.html /usr/share/nginx/html/404.html
COPY ./nginx/error-pages/50x.html /usr/share/nginx/html/50x.html

# Create directories with proper permissions
RUN mkdir -p /var/cache/nginx /var/log/nginx /var/run /etc/nginx/conf.d && \
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx /var/run /usr/share/nginx/html && \
    # Remove Alpine's default nginx config that serves static files and interferes with our routing
    rm -f /etc/nginx/conf.d/default.conf

# Set working directory
WORKDIR /etc/nginx

# Grant CAP_NET_BIND_SERVICE to nginx binary to allow non-root user to bind to ports 80/443
# This allows nginx to bind to privileged ports (80, 443) without running as root
RUN setcap 'cap_net_bind_service=+ep' /usr/sbin/nginx && \
    getcap /usr/sbin/nginx

# Switch to nginx user
USER nginx

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

EXPOSE 80 443

ENTRYPOINT ["/usr/local/bin/run-nginx.sh"]
