# Multi-stage production build for L30 Library Frontend
# Stage 1: Vite app build
FROM node:20-alpine as builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --prefer-offline --no-audit --legacy-peer-deps

COPY . .

# Sentry DSN is a public client key (same pattern as the Turnstile site key below).
# A hardcoded overridable default keeps image builds from baking a dark Sentry
# (frontend/.env.production is untracked, so clean-worktree builds never see it).
ARG VITE_SENTRY_DSN=https://a1180114bc2b37d5ad62e87aa593c52f@o4510217194700800.ingest.us.sentry.io/4511047312998400
ENV VITE_SENTRY_DSN=${VITE_SENTRY_DSN}
ARG VITE_TURNSTILE_SITE_KEY=0x4AAAAAADScAwmbInNfrn7X
ENV VITE_TURNSTILE_SITE_KEY=${VITE_TURNSTILE_SITE_KEY}

RUN npm run build

# Stage 2: Compile Google ngx_brotli module against the runtime nginx version.
# No third-party images: we use the trusted nginx:alpine and build from source.
FROM nginx:alpine AS brotli-builder
RUN apk add --no-cache --virtual .build-deps \
    git build-base pcre2-dev zlib-dev openssl-dev linux-headers wget brotli-dev
RUN NGX_VER=$(nginx -v 2>&1 | awk -F/ '{print $2}') && \
    cd /tmp && \
    git clone --recurse-submodules --depth=1 https://github.com/google/ngx_brotli.git && \
    wget -qO- "http://nginx.org/download/nginx-${NGX_VER}.tar.gz" | tar xz && \
    cd "nginx-${NGX_VER}" && \
    ./configure --with-compat --add-dynamic-module=/tmp/ngx_brotli && \
    make modules -j$(nproc) && \
    mkdir -p /modules && \
    cp objs/ngx_http_brotli_*.so /modules/

# Stage 3: Runtime
FROM nginx:alpine

RUN apk add --no-cache curl brotli-libs

RUN addgroup -g 101 -S nginx && \
    adduser -S -D -H -u 101 -h /var/cache/nginx -s /sbin/nologin -G nginx -g nginx nginx || true

# Bring in compiled brotli dynamic modules
COPY --from=brotli-builder /modules/ngx_http_brotli_filter_module.so /usr/lib/nginx/modules/
COPY --from=brotli-builder /modules/ngx_http_brotli_static_module.so /usr/lib/nginx/modules/

# Built frontend
COPY --from=builder /app/dist /usr/share/nginx/html

# Pre-compress static assets at build time. brotli_static + gzip_static then
# serve these directly with zero per-request compression cost.
RUN apk add --no-cache --virtual .compress-tools brotli && \
    find /usr/share/nginx/html -type f \
      \( -name '*.js' -o -name '*.css' -o -name '*.json' -o -name '*.svg' -o -name '*.html' -o -name '*.ico' \) \
      -size +1024c -print0 | \
    xargs -0 -P 4 -I {} sh -c 'brotli --best -k -- "$1" && gzip -9 -k -- "$1" 2>/dev/null || true' _ {} && \
    apk del .compress-tools

# Server config (server block; brotli directives live here)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Permissions for non-root cache + html
RUN mkdir -p /var/cache/nginx /var/run/nginx && \
    chown -R nginx:nginx /var/cache/nginx /var/run/nginx /usr/share/nginx/html

# Load brotli modules at top of nginx.conf (must be outside http{}) and
# fix nginx.conf pid path for writability
RUN sed -i '1i load_module modules/ngx_http_brotli_filter_module.so;\nload_module modules/ngx_http_brotli_static_module.so;' /etc/nginx/nginx.conf && \
    sed -i 's|pid /var/run/nginx.pid;|pid /tmp/nginx.pid;|g' /etc/nginx/nginx.conf

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:80/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
