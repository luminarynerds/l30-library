{
  "name": "lsc-library-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:undef": "node scripts/check-undefined-imports.mjs",
    "lint": "eslint src --report-unused-disable-directives",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:journey": "playwright test e2e/journey-*.spec.ts --project=chromium",
    "test:journey:all": "playwright test e2e/journey-*.spec.ts",
    "test:journey:mobile": "playwright test e2e/journey-*.spec.ts --project=mobile-375px --project=mobile-390px --project=tablet-768px",
    "test:mobile-layout": "playwright test e2e/journey-mobile-layout.spec.ts --project=chromium",
    "test:journey:a11y": "playwright test e2e/journey-accessibility-regression.spec.ts",
    "test:journey:headed": "playwright test e2e/journey-*.spec.ts --headed",
    "test:api-coverage": "playwright test e2e/api-coverage.spec.ts",
    "test:a11y": "vitest run src/__tests__/pages/public-pages-accessibility.test.tsx",
    "test:links": "playwright test broken-links.spec.ts",
    "test:links:cli": "linkinator http://localhost:5173 --config linkinator.config.json",
    "test:links:build": "linkinator ./dist --config linkinator.config.json",
    "test:lighthouse": "lhci autorun --config=lighthouserc.js",
    "test:smoke": "SMOKE_ONLY=true playwright test --project=smoke",
    "test:explore": "SMOKE_ONLY=true playwright test --project=explore",
    "test:all": "npm run test -- --run && npm run test:e2e",
    "validate:translations": "node ../scripts/validate-translations.js",
    "validate:translations:verbose": "node ../scripts/validate-translations.js --verbose",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "audit:ui-api-coverage": "node scripts/check-ui-api-coverage.mjs",
    "api:generate-spec": "cd ../backend && DATABASE_URL=sqlite+aiosqlite:///./test.db SECRET_KEY=openapi-generation PII_ENCRYPTION_ENABLED=false .venv/bin/python scripts/generate_openapi.py --format json --output openapi.json",
    "api:generate-types": "openapi-typescript ../backend/openapi.json -o src/api/generated/schema.d.ts && python3 ../spdx_header.py --root src/api/generated --copyright \"Luminary Nerds\" --apply",
    "api:generate": "npm run api:generate-spec && npm run api:generate-types",
    "api:check": "node scripts/check-api-types-freshness.mjs",
    "api:check-bodies": "node scripts/check-api-request-bodies.mjs --openapi ../backend/openapi.json",
    "lint:i18n": "node scripts/check-i18n-keys.mjs",
    "lint:i18n:warn": "node scripts/check-i18n-keys.mjs --warn",
    "lint:i18n:staged": "node scripts/check-i18n-keys.mjs --staged --warn",
    "lint:knip": "knip",
    "lint:knip:delta": "node scripts/knip-delta.mjs",
    "lint:knip:delta:warn": "node scripts/knip-delta.mjs --warn",
    "knip:rebaseline": "node scripts/knip-delta.mjs --rebaseline"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.3.2",
    "@sentry/browser": "^10.39.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-virtual": "3.14.5",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.0.0",
    "dompurify": "^3.4.17",
    "epubjs": "^0.3.93",
    "focus-trap-react": "^10.3.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.453.0",
    "markdown-it": "^14.3.0",
    "openapi-fetch": "^0.17.0",
    "prop-types": "^15.8.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "tmp": "^0.2.7",
    "minimatch": "^10.0.0",
    "glob": "^10.0.0",
    "js-yaml": "^4.1.1",
    "flatted": "^3.4.0",
    "undici": "^7.24.0",
    "yauzl": "^3.2.1",
    "basic-ftp": "^5.3.1",
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "proxy-addr": "^2.0.8",
    "postcss-selector-parser": "^6.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@axe-core/react": "4.12.1",
    "@eslint/js": "^9.39.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/jest-axe": "^3.5.9",
    "@types/leaflet": "^1.9.21",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^17.7.0",
    "happy-dom": "^21.0.4",
    "jest-axe": "^10.0.0",
    "knip": "6.23.0",
    "linkinator": "^7.6.1",
    "msw": "^2.14.6",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.12",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "storybook": "^8.6.19",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.1",
    "terser": "^5.48.0",
    "ts-morph": "^28.0.0",
    "tsc-files": "^1.1.4",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.0",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^4.1.10"
  }
}
