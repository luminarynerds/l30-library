# ============================================================================
# L30 Library System - Environment Variables Configuration Template
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in all REQUIRED values (marked with *** REQUIRED ***)
# 3. Adjust optional values as needed for your environment
# 4. NEVER commit .env to version control - it contains secrets
# ============================================================================

# --- CORE APPLICATION ---
DEBUG=false
ENVIRONMENT=development
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:5173

# --- DATABASE (*** REQUIRED ***)
# Format: postgresql+asyncpg://username:password@host:port/database_name
# Example: postgresql+asyncpg://lsc:password123@localhost:5432/lsc_library
DATABASE_URL=postgresql+asyncpg://lsc:password@localhost:5432/lsc_library
# SSL required for production connections
DATABASE_REQUIRE_SSL=false

# --- REDIS CACHE (for sessions and caching)
# SECURITY: Include password for production
# Format: redis://:password@host:port/db_number
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
# Enable TLS for Redis connections (recommended for production)
REDIS_SSL=false
# Certificate verification: "required", "optional", or "none"
REDIS_SSL_CERT_REQS=required
# Path to CA certificates for Redis TLS verification
REDIS_SSL_CA_CERTS=

# --- AUTHENTICATION (*** REQUIRED ***)
# Generate random secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_super_secret_key_here_change_this_in_production
JWT_SECRET_KEY=your_jwt_secret_here_change_this_in_production

# --- AUTHENTICATION CONFIGURATION ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_MIN_LENGTH=8

# --- EMAIL / RESEND (optional)
# Get token from: https://resend.com/
RESEND_API_KEY=
FROM_EMAIL=noreply@l30.org

# --- ERROR TRACKING / SENTRY (optional but recommended for production)
# Get DSN from: https://sentry.io/
# Format: https://key@org.ingest.sentry.io/project
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- LOGGING & MONITORING ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log format: "json" for structured JSON logs, "text" for human-readable
LOG_FORMAT=json

# --- CORS (comma-separated list of allowed origins) ---
# Development default: localhost ports
# Production: Use only HTTPS URLs
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://l30.org

# --- PII ENCRYPTION (*** REQUIRED IN PRODUCTION ***)
# CRITICAL: Must be enabled in production for GDPR/CCPA compliance
# Generate new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_ENABLED=false
PII_ENCRYPTION_KEY=

# --- DATABASE USER SETUP (for container initialization) ---
# Only needed if using Docker containers with database initialization
DB_USER=lsc
DB_PASSWORD=change_this_password
DB_NAME=lsc_library

# ============================================================================
# Z39.50 COPY CATALOGING CONFIGURATION
# ============================================================================
# Configures Z39.50 servers for copy cataloging (searching external library catalogs)
# SECURITY: These are public server addresses; no credentials needed for LOC
#
# Two configuration methods:
# 1. Individual environment variables (recommended for simple setups)
# 2. JSON string for advanced configurations (Z3950_SOURCES_JSON)

# --- Library of Congress Z39.50 Server ---
Z3950_LOC_HOST=lx2.loc.gov
Z3950_LOC_PORT=210
Z3950_LOC_DATABASE=LCDB

# --- OCLC WorldCat Z39.50 Server ---
# NOTE: Requires OCLC subscription/authentication
Z3950_OCLC_HOST=z3950.oclc.org
Z3950_OCLC_PORT=210
Z3950_OCLC_DATABASE=OLUCWorldCat
Z3950_OCLC_REQUIRES_AUTH=true

# --- Advanced: Full Z39.50 Configuration as JSON ---
# Alternative method: specify entire configuration as JSON string
# Useful for adding custom sources or overriding defaults
# Example format:
# Z3950_SOURCES_JSON={"loc":{"name":"Library of Congress","host":"lx2.loc.gov","port":210,"database":"LCDB","syntax":"USMARC","encoding":"UTF-8"},"oclc":{"name":"OCLC WorldCat","host":"z3950.oclc.org","port":210,"database":"OLUCWorldCat","syntax":"USMARC","encoding":"UTF-8","requires_auth":true}}
# Leave empty to use individual variables above
Z3950_SOURCES_JSON=

# ============================================================================
# OLLAMA AI SERVICE CONFIGURATION
# ============================================================================
# Configures connection to local Ollama instance for LLM inference
# Ollama provides local, privacy-preserving AI capabilities
#
# Installation: https://ollama.ai
# After install, start with: ollama serve
# Pull models: ollama pull llama3.2

# Base URL for Ollama instance
# Development: http://localhost:11434
# Docker: http://ollama:11434 (when using internal Docker networking)
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# EMBEDDING API (Semantic Search)
# ============================================================================
# Supports OpenAI or any OpenAI-compatible API (e.g. Ollama)
# For Ollama: set EMBEDDING_API_URL=http://localhost:11434/v1/embeddings
#             and leave OPENAI_API_KEY empty
# For OpenAI: set OPENAI_API_KEY and leave EMBEDDING_API_URL as default
OPENAI_API_KEY=
EMBEDDING_API_URL=http://localhost:11434/v1/embeddings
# Model and dimension - must match your provider:
#   OpenAI:  text-embedding-3-small (1536 dims)
#   Ollama:  nomic-embed-text (768), mxbai-embed-large (1024), all-minilm (384)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# ============================================================================
# VIRUS SCANNING CONFIGURATION
# ============================================================================
# Configures ClamAV antivirus for file upload scanning
# Install ClamAV: https://www.clamav.net/

# Enable/disable virus scanning
VIRUS_SCAN_ENABLED=true
# Fail-closed: reject files if scanner encounters errors
VIRUS_SCAN_FAIL_ON_ERROR=true

# ClamAV Unix socket (preferred for Docker/same-host connections)
CLAMAV_SOCKET=/var/run/clamav/clamd.sock

# ClamAV TCP connection (alternative to socket)
CLAMAV_HOST=
CLAMAV_PORT=3310

# ============================================================================
# SIP2 SELF-CHECKOUT KIOSK INTEGRATION
# ============================================================================
# Configures SIP2 protocol for self-checkout kiosk integration
# SECURITY: Enable TLS in production to encrypt patron credentials

# Enable SIP2 server
SIP2_ENABLED=false
SIP2_HOST=0.0.0.0
SIP2_PORT=6001
SIP2_INSTITUTION_ID=LSC
SIP2_LIBRARY_NAME=L30 Library

# SIP2 Security Settings
SIP2_TERMINAL_PASSWORD=
SIP2_REQUIRE_CHECKSUM=true
SIP2_REQUIRE_LOGIN=true

# TLS Configuration (REQUIRED for production - encrypts patron credentials)
# Default: true in production to prevent plaintext transmission
SIP2_USE_TLS=true
SIP2_TLS_CERT=
SIP2_TLS_KEY=

# Connection limits
SIP2_CONNECTION_TIMEOUT=300
SIP2_MAX_CONNECTIONS=100

# --- SCHEDULER SETTINGS ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
OVERDUE_NOTICE_INTERVAL_DAYS=7
HOLD_EXPIRY_DAYS=7
OVERDUE_FINE_PER_DAY=0.25

# --- ENDPOINT TRACKING & MONITORING ---
ENABLE_ENDPOINT_TRACKING=true

# --- LOST ITEM DETECTION ---
LOST_ITEM_THRESHOLD_DAYS=30
LOST_ITEM_DEFAULT_REPLACEMENT_COST=25.00

# ============================================================================
# HORIZONTAL SCALING CONFIGURATION
# ============================================================================
# Settings to enable horizontal scaling across multiple instances

# --- DATABASE CONNECTION POOL ---
# Tune these values based on number of instances and PostgreSQL max_connections
# Total connections = instances * (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# Example: 3 instances with pool_size=10, max_overflow=15 = 75 total connections
# PostgreSQL default max_connections=100, so plan accordingly
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# --- FILE STORAGE ---
# For horizontal scaling, use S3 or shared storage instead of local filesystem
# Backend options: "local" or "s3"
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/uploads

# S3 Configuration (required when STORAGE_BACKEND=s3)
# Works with AWS S3, MinIO, DigitalOcean Spaces, etc.
S3_BUCKET=
S3_REGION=us-east-1
# For S3-compatible services (MinIO, DO Spaces), set custom endpoint:
S3_ENDPOINT_URL=
# AWS credentials (or use IAM roles in AWS environments)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
