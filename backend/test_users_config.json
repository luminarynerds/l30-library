  "role_hierarchy": {
    "SUPER_ADMIN": {
      "level": 9,
      "description": "Unrestricted system access"
    },
    "ADMIN": {
      "level": 8,
      "description": "Full system administration"
    },
    "DIRECTOR": {
      "level": 7,
      "description": "Strategic and sensitive operations"
    },
    "LEGAL": {
      "level": 6,
      "description": "Law enforcement and legal requests"
    },
    "STAFF": {
      "level": 5,
      "description": "Daily operations staff"
    },
    "BOOKMOBILE": {
      "level": 4,
      "description": "Mobile library service"
    },
    "HOMEBOND": {
      "level": 3,
      "description": "Home delivery service"
    },
    "PATRON": {
      "level": 2,
      "description": "Regular patron"
    },
    "CHILD": {
      "level": 1,
      "description": "Child patron (COPPA)"
    }
  },
  "testing_endpoints": {
    "login": {
      "method": "POST",
      "path": "/api/v1/auth/login",
      "content_type": "application/x-www-form-urlencoded",
      "example": "curl -X POST http://localhost:8000/api/v1/auth/login -d 'username=admin@l30.org&password=Admin@123!'"
    },
    "current_user": {
      "method": "GET",
      "path": "/api/v1/auth/me",
      "requires_auth": true
    },
    "logout": {
      "method": "POST",
      "path": "/api/v1/auth/logout",
      "requires_auth": true
    },
    "refresh": {
      "method": "POST",
      "path": "/api/v1/auth/refresh",
      "requires_auth": false
    }
  },
  "checklist": {
    "authentication": [
      "SUPER_ADMIN login succeeds",
      "ADMIN login succeeds",
      "DIRECTOR login succeeds",
      "LEGAL login succeeds",
      "STAFF login succeeds",
      "PATRON login succeeds",
      "CHILD login succeeds",
      "BOOKMOBILE login succeeds",
      "HOMEBOND login succeeds",
      "Login fails with wrong password",
      "Login fails with non-existent email"
    ],
    "authorization": [
      "SUPER_ADMIN can access all features",
      "ADMIN can manage users",
      "DIRECTOR can access sensitive reports",
      "LEGAL can process law enforcement requests",
      "STAFF can process circulation",
      "PATRON can browse catalog",
      "CHILD cannot access adult materials",
      "BOOKMOBILE can process mobile checkouts",
      "HOMEBOND can manage deliveries"
    ],
    "permissions": [
      "PATRON cannot access admin panel",
      "CHILD reading minutes tracking works",
      "GUARDIAN can manage child account",
      "STAFF cannot modify system settings",
      "LEGAL can only access law enforcement features"
    ]
  }
}
