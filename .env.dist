# =============================================================================
# L30 Library System - Environment Configuration
# =============================================================================
# Run ./setup.sh to auto-generate secrets and fill in your library details.
# Or copy this to .env and edit manually.
# =============================================================================

# --- Your Library ---
DOMAIN=your-library.example.com
LIBRARY_NAME=Your Library
LIBRARY_TIMEZONE=America/New_York
FROM_EMAIL=library@example.com
FRONTEND_URL=https://your-library.example.com

# --- Database ---
DB_USER=l30
DB_PASSWORD=CHANGE_ME
DB_NAME=l30_library

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME

# --- Security (generate with: openssl rand -base64 48) ---
SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME

# --- PII Encryption (generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ---
PII_ENCRYPTION_ENABLED=true
PII_ENCRYPTION_KEY=CHANGE_ME

# --- PII Blind-Index Hash Key (generate with: openssl rand -hex 32) ---
# Required in production when PII_ENCRYPTION_ENABLED=true -- the backend
# refuses to boot without it (see app/core/config.py).
PII_HASH_KEY=CHANGE_ME

# --- Security Salts (generate with: openssl rand -base64 32) ---
WATERMARK_SECRET_SALT=CHANGE_ME
DOWNLOAD_IP_HASH_SALT=CHANGE_ME

# --- MetisLib Patron Hash (generate with: openssl rand -base64 32) ---
METISLIB_PATRON_HASH_SECRET=CHANGE_ME

# --- Audit Log Signing (generate with: openssl rand -hex 32) ---
AUDIT_LOG_SIGNING_KEY=CHANGE_ME

# --- CORS (comma-separated allowed origins) ---
CORS_ORIGINS=https://your-library.example.com,https://www.your-library.example.com

# --- Bot verification (Cloudflare Turnstile) ---
# CF_TURNSTILE_SECRET: your Cloudflare Turnstile secret key. Leave unset if you
# don't have a Cloudflare account -- login/magic-link verification fails
# CLOSED without it in production (nobody can log in), unless you set the
# escape hatch below.
CF_TURNSTILE_SECRET=

# TURNSTILE_DISABLED: self-host escape hatch. Set to true to skip Turnstile
# bot verification entirely (no Cloudflare account required) so a fresh
# self-host install can log in out of the box.
#
# SCOPE: this is NOT limited to login. verify_turnstile is the single
# choke point for every public form in the app -- login and magic-link,
# patron registration, event registration, book challenge submissions,
# public-records requests, card applications, account-security actions,
# and password resets. Leaving this true DISABLES bot/CAPTCHA protection
# on ALL of them, not just login.
#
# Fine for a self-host/offline/single-library install behind your own
# network controls where nothing above is reachable from the internet.
# But before you expose this site's patron portal to the public internet
# (the normal path once a library goes live), get a real
# CF_TURNSTILE_SECRET from Cloudflare and set this back to false -- the
# app logs a startup warning if it detects TURNSTILE_DISABLED=true in
# production, but don't rely on the log line alone.
TURNSTILE_DISABLED=true

# --- Application ---
ENVIRONMENT=production
LOG_LEVEL=INFO
WORKERS=2
SKIP_SEEDS=true

# --- Storage ---
STORAGE_BACKEND=local

# --- Optional: Email (set to enable outgoing email) ---
RESEND_API_KEY=

# --- Optional: Error Tracking ---
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Optional: AI Features (requires running Ollama instance) ---
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- Optional: MetisLib Integration ---
METISLIB_ENABLED=false
METISLIB_BASE_URL=
METISLIB_API_KEY=
METISLIB_LIBRARY_ID=

# --- Optional: S3 Storage (default is local filesystem) ---
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional: Backup at-rest encryption (age) ---
# Path to a file with one or more age PUBLIC recipients (one per line).
# When set, automated-backup.sh streams pg_dump | gzip | age and writes
# *.sql.gz.age archives. The matching SECRET identity must NEVER live on
# this host. See docs/security/disk-encryption.md.
# Run scripts/install-backup-age-key.sh age1xxxx... to wire this up.
# BACKUP_AGE_RECIPIENTS_FILE=/etc/l30/backup-recipients
